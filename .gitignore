# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
*.swp
*~
*.bak

# Keep shared VS Code / Cursor workspace settings; ignore local-only IDE junk.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.history/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.kubeconfig
kubeconfig
kubeconfig.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
dist/
build/
sdist/
wheels/
pip-wheel-metadata/
.venv/
venv/
ENV/
.env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.cache/
.pytype/
.pyre/

# --- Shell / local tooling ---
*.log
*.out
.direnv/
.asdf/
shell.nix.bak

# --- Terraform ---
.terraform/
.terraform.tfstate.backup
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lockfile SHOULD be committed for root modules — do not ignore .terraform.lock.hcl

# --- Kubernetes / Kustomize ---
# Do not ignore manifests (*.yaml / kustomization.yaml) — those are source.
.kube/
*.kubeconfig.yaml
# Common local render / apply scratch dirs
**/rendered/
**/kustomize-out/
**/kubectl-out/

# --- Helm ---
# Chart source stays tracked; ignore fetched deps and packages.
**/charts/**/charts/
**/charts/**/tmpcharts/
*.tgz
*.tgz.prov
# Chart.lock is usually committed for apps; uncomment to ignore if you prefer:
# Chart.lock

# --- Argo CD / Flux CD ---
# Keep GitOps YAML tracked. Ignore local decryption / bootstrap leftovers.
**/argocd/secrets/
**/flux/secrets/
*.agekey
keys.txt
# SOPS / sealed-secret local material (encrypted secrets.yaml stays tracked)
*.dec.yaml
*.decoded.yaml
secrets.local.yaml

# --- OKF ---
# Incremental OKF compile cache (regenerated by `okf.py compile`)
_okf_knowledge/.okf-compile-cache.json
